# =============================================================================
# 生产环境配置模板 —— 复制为 .env.production 后填值
# 凡有 *** CHANGE ME *** 标记的必须修改！
# 生成随机串：python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# ===== 镜像版本（可选） =====
IMAGE_TAG=latest

# ===== TLS / 域名（nginx + certbot 签发 Let's Encrypt 证书） =====
# WEB_DOMAIN：必须解析到本机公网 IP，且 80/443 端口对外开放，nginx 用它做 server_name 和证书路径
# ACME_EMAIL：Let's Encrypt 账号绑定邮箱，证书过期前会发提醒；仅 deploy/scripts/init-cert.sh 使用
WEB_DOMAIN=*** CHANGE ME (e.g. resume.example.com) ***
ACME_EMAIL=*** CHANGE ME (e.g. ops@example.com) ***
# S3_DOMAIN：对外 S3 对象存储 API 的独立子域（nginx 第二个 443 server 块完整透传 MinIO，公网读写）
#   必填项，级别同 WEB_DOMAIN：DNS A 记录指向本机；首次部署由 init-cert.sh 一并签发证书；
#   已在运行的环境用 webroot 方式追加签发（见 md/minio/s3-subdomain-guide.md）。
#   不想要公网 S3 的环境：从 frontend/nginx/default.conf.template 删除第二个 server 块并把本行留空
S3_DOMAIN=*** CHANGE ME (e.g. s3.resume.example.com) ***

# ===== 应用核心 =====
APP_NAME=简历筛选平台
DEBUG=false
SECRET_KEY=*** CHANGE ME (32+ random bytes) ***
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGGING_LEVEL=INFO

# ===== MySQL =====
# DB_ROOT_PASSWORD 给 mysql 容器初始化 root 用，应用走 DB_USER
DB_ROOT_PASSWORD=*** CHANGE ME ***
DB_NAME=resume
DB_USER=resume_app
DB_PASSWORD=*** CHANGE ME ***
DB_PORT=3306
# DB_HOST 在 compose 中被强制改为 mysql，不要在这里改

# ===== Redis =====
# 留空表示不启用密码（仅靠 docker 网络隔离）；生产建议设强密码
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# ===== LLM =====
OPENAI_API_KEY=*** CHANGE ME (sk-...) ***
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
FALLBACK_MODEL=qwen-turbo

# ===== 存储 =====
STORAGE_TYPE=LOCAL
# LOCAL_STORAGE_PATH 在 compose 中被强制改为 /app/note（挂载到 resume_storage 卷）

# ===== MinIO 对象存储（供其它项目共用；nginx /file/ 反代其公开下载） =====
# root 凭证：既是 Web Console 登录账号，也是 mc/SDK 的管理员 AccessKey/SecretKey
# 用户名 >= 3 字符、密码 >= 8 字符；生成强密码：python -c "import secrets; print(secrets.token_urlsafe(16))"
# 各接入项目建议另建受限子账号（mc admin user add），不要下发 root 凭证
MINIO_ROOT_USER=*** CHANGE ME (e.g. resume_minio) ***
MINIO_ROOT_PASSWORD=*** CHANGE ME (>= 8 chars strong) ***

# ===== LangGraph Checkpointer =====
# 在 compose 中被强制改为 /app/data/langgraph_checkpoints.sqlite（挂载到 langgraph_data 卷）

# ===== 邮件 SMTP =====
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=*** CHANGE ME ***
SMTP_PASSWORD=*** CHANGE ME ***
EMAIL_FROM=*** CHANGE ME ***

# ===== Celery（默认空 → 自动用同库 Redis 的 db=1/2） =====
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ===== 初始管理员（首次启动若没有管理员则创建） =====
# 上线后第一次登录请立即改密码或在管理后台创建正式账号
INIT_ADMIN_EMAIL=admin@example.com
INIT_ADMIN_PASSWORD=*** CHANGE ME ***
INIT_ADMIN_REAL_NAME=超级管理员
INIT_ADMIN_EMP_NO=ADMIN001
